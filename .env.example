# Copy: cp .env.example .env

# --- App ---
APP_NAME=Trading Analysis API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- KIS (pykis) ---
KIS_HTS_ID=YOUR_HTS_ID
KIS_APP_KEY=YOUR_APP_KEY
KIS_APP_SECRET=YOUR_APP_SECRET
KIS_ACCOUNT=00000000-01
# true = virtual appkey, false = live/production appkey
KIS_VIRTUAL=false
# Optional: prebuilt auth file path (takes precedence when present)
# Copy examples: cp secret.json.example secret.json
#                cp virtual_secret.json.example virtual_secret.json
# IMPORTANT: secret.json must be live/production keys (virtual=false).
#            pykis rejects virtual=true as the primary auth file.
KIS_AUTH_PATH=secret.json

# --- Toss Securities Open API ---
# Client Credentials. IP allowlist is configured on Toss WTS.
TOSS_CLIENT_ID=YOUR_TOSS_CLIENT_ID
TOSS_CLIENT_SECRET=YOUR_TOSS_CLIENT_SECRET
TOSS_ACCOUNT=
TOSS_API_BASE_URL=https://openapi.tossinvest.com

# --- LLM provider ---
# Testing default: nvidia only (Ollama locked)
# OLLAMA_ENABLED=true 로 다시 켤 수 있음
LLM_PROVIDER=nvidia
EMBED_PROVIDER=nvidia
LLM_FAILOVER=false
OLLAMA_ENABLED=false

# --- Ollama / local RAG (ignored when OLLAMA_ENABLED=false) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:31b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SEC=180
MAX_NEW_TOKENS=2048
LLM_TEMPERATURE=0.3

# --- NVIDIA NIM / API Catalog ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=openai/gpt-oss-120b
# Retrieval companion for gpt-oss-120b RAG
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_TIMEOUT_SEC=180

# --- RAG tuning ---
BM25_K=5
FAISS_K=5
BM25_WEIGHT=0.7
FAISS_WEIGHT=0.3
MAX_DOCS=8
MAX_CONTEXT_LENGTH=3500

# --- Market / News / Recommend ---
DEFAULT_TICKER=005930
DEFAULT_EXCHANGE_RATE=1300.0
NEWS_MAX_ITEMS=20
NEWS_LANGUAGE=ko
RECOMMEND_TOP_N=10
RECOMMEND_LOOKBACK_DAYS=60
